{
  "name": "tandem",
  "version": "0.0.0",
  "description": "Company workspace where human and AI employees work together — SSH environments run the Hermes agent as the task runner.",
  "license": "MIT",
  "author": "namhtpyn",
  "repository": {
    "type": "git",
    "url": "https://github.com/namhtpyn/tandem.git"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "NITRO_BUN_IDLE_TIMEOUT=255 bun .output/server/index.mjs",
    "check": " bun format && bun lint:check && bun typecheck",
    "typecheck": "bunx vue-tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p scripts/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "nuxt prepare",
    "gen:auth": "bun run scripts/gen-auth-schema.ts",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.11",
    "@better-auth/drizzle-adapter": "1.7.11",
    "@keyv/redis": "5.1.6",
    "@nuxt/fonts": "1.0.1",
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.12.0",
    "@orpc/client": "2.0.0-beta.44",
    "@orpc/publisher": "2.0.0-beta.44",
    "@orpc/server": "2.0.0-beta.44",
    "@orpc/tanstack-query": "2.0.0-beta.44",
    "@tanstack/vue-query": "5.104.5",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "better-auth": "1.7.11",
    "bullmq": "6.3.17",
    "cache-manager": "7.2.9",
    "drizzle-orm": "1.0.0-rc.4",
    "es-toolkit": "1.52.0",
    "keyv": "5.6.0",
    "nuxt": "4.6.2",
    "postgres": "3.4.9",
    "redis": "6.3.0",
    "ssh2": "1.17.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dxup/nuxt": "0.5.10",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/ssh2": "1.15.6",
    "@vitest/browser": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "drizzle-kit": "1.0.0-rc.4",
    "happy-dom": "21.0.3",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "semantic-release": "25.0.9",
    "type-fest": "5.10.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
    "typescript-native-bridge": "6.0.3-bridge.18.tsgo.7.0.2",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "typescript": "$typescript"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.4.2"
}
