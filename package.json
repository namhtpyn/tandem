{
  "name": "tandem",
  "version": "0.0.0",
  "description": "Company workspace where human and AI employees work together — SSH environments run the Hermes agent as the task runner.",
  "license": "MIT",
  "author": "namhtpyn",
  "repository": {
    "type": "git",
    "url": "https://github.com/namhtpyn/tandem.git"
  },
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "NITRO_BUN_IDLE_TIMEOUT=255 bun .output/server/index.mjs",
    "typecheck": "bunx vue-tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:ui": "bun --bun vitest --ui",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:e2e": "bunx --bun playwright test",
    "test:e2e:ui": "bunx --bun playwright test --ui",
    "pretest:e2e": "bun run build",
    "postinstall": "nuxt prepare",
    "gen:auth": "bun run scripts/gen-auth-schema.ts",
    "lint:fix": "bunx --bun oxlint --fix",
    "lint:check": "bunx --bun oxlint",
    "format": "bunx --bun oxfmt",
    "format:check": "bunx --bun oxfmt --check",
    "test:unit": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.12",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@keyv/redis": "6.1.0",
    "@nuxt/fonts": "1.0.1",
    "@nuxt/icon": "2.5.1",
    "@nuxt/ui": "4.12.0",
    "@orpc/client": "2.0.0-beta.44",
    "@orpc/publisher": "2.0.0-beta.44",
    "@orpc/server": "2.0.0-beta.44",
    "@orpc/tanstack-query": "2.0.0-beta.44",
    "@tanstack/vue-query": "5.104.5",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@vueuse/core": "15.0.0",
    "@vueuse/nuxt": "15.0.0",
    "better-auth": "1.7.12",
    "bullmq": "6.4.0",
    "cache-manager": "7.2.9",
    "consola": "^3.4.2",
    "drizzle-orm": "1.0.0-rc.5",
    "es-toolkit": "1.52.0",
    "keyv": "6.1.0",
    "nuxt": "4.6.2",
    "redis": "6.3.0",
    "ssh2": "1.17.0",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dxup/nuxt": "0.5.10",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/ssh2": "1.15.6",
    "@vitest/browser": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "bun-types": "1.4.3",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-seed": "1.0.0-rc.5",
    "happy-dom": "21.0.4",
    "oxlint": "1.89.0",
    "semantic-release": "25.0.9",
    "testcontainers": "12.2.1",
    "type-fest": "5.10.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.18.tsgo.7.0.2",
    "typescript-native-bridge": "6.0.3-bridge.18.tsgo.7.0.2",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "typescript": "$typescript"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "packageManager": "bun@1.4.2"
}
